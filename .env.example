# Salin file ini menjadi .env.local lalu isi kunci OpenRouter Anda.
# Dapatkan kunci di https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# (Opsional) Model OpenRouter. Default: openrouter/free (router gratis, otomatis
# memilih model gratis yang mendukung tool calling). Lineup model :free sering
# berganti, jadi router ini lebih tahan banting daripada mengunci satu model.
# OPENROUTER_MODEL=openrouter/free

# (Opsional) URL aplikasi untuk atribusi di dashboard OpenRouter
# OPENROUTER_APP_URL=https://biaya-bangun.app
